{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoCrop",
  "version": "3.0.0",
  "identifier": "com.azmek.videocrop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VideoCrop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0f1012"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://stream.localhost stream:; media-src 'self' blob: http://stream.localhost stream:; connect-src 'self' ipc: http://ipc.localhost http://stream.localhost stream:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
