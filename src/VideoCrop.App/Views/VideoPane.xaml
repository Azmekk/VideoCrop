<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VideoCrop.App.Views.VideoPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Placeholder for the embedded mpv child HWND. The HWND is positioned
             on top of this Border at the OS compositor level; XAML cannot draw
             over the video region, so we keep transport controls in row 1. -->
        <Border x:Name="VideoPlaceholder"
                Grid.Row="0"
                Background="Black"
                CornerRadius="6">
            <StackPanel x:Name="EmptyOverlayPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="32" Opacity="0.5" />
                <TextBlock x:Name="EmptyOverlay"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           TextAlignment="Center"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Drop a video here, or click Open File." />
                <Button x:Name="ReopenPlayerButton"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnReopenPlayerClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Reopen player" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="TransportBar"
              Grid.Row="1"
              Margin="0,8,0,0"
              ColumnSpacing="8"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="PlayPauseButton"
                    MinWidth="80"
                    Click="OnPlayPauseClick">
                <TextBlock x:Name="PlayPauseLabel" Text="Play" />
            </Button>

            <Slider Grid.Column="1"
                    x:Name="PositionSlider"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.01"
                    ValueChanged="OnSliderValueChanged"
                    PointerCaptureLost="OnSliderPointerCaptureLost" />

            <TextBlock Grid.Column="2"
                       x:Name="PositionLabel"
                       VerticalAlignment="Center"
                       Text="00:00 / 00:00" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <FontIcon x:Name="VolumeIcon"
                          FontFamily="Segoe Fluent Icons"
                          Glyph="&#xE767;"
                          FontSize="14"
                          VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider"
                        Width="90"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        StepFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="OnVolumeSliderChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
