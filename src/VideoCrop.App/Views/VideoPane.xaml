<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VideoCrop.App.Views.VideoPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="16">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="32" Opacity="0.5" />
                <TextBlock x:Name="EmptyOverlay"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           TextAlignment="Center"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Drop a video here, or click Open File.&#x0a;Playback opens in a separate mpv window." />
            </StackPanel>
        </Border>

        <Grid x:Name="TransportBar"
              Grid.Row="1"
              Margin="0,8,0,0"
              ColumnSpacing="8"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="PlayPauseButton"
                    MinWidth="80"
                    Click="OnPlayPauseClick">
                <TextBlock x:Name="PlayPauseLabel" Text="Play" />
            </Button>

            <Slider Grid.Column="1"
                    x:Name="PositionSlider"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.01"
                    ValueChanged="OnSliderValueChanged"
                    PointerCaptureLost="OnSliderPointerCaptureLost" />

            <TextBlock Grid.Column="2"
                       x:Name="PositionLabel"
                       VerticalAlignment="Center"
                       Text="00:00 / 00:00" />
        </Grid>
    </Grid>
</UserControl>
