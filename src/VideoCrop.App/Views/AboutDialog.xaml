<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="VideoCrop.App.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="About VideoCrop"
    PrimaryButtonText="OK"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="10" Width="460">
        <TextBlock Text="VideoCrop" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Opacity="0.7" />
        <TextBlock TextWrapping="Wrap">
            A desktop tool for cutting, cropping, resizing, and compressing video.
            Uses ffmpeg/ffprobe for encoding and mpv for playback.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" Text="Third-party tools" />
        <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12">
            • mpv — licensed under GPLv2+. Run as a separate process; license bundled.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12">
            • ffmpeg/ffprobe — LGPL or GPL build, depending on what fetch-tools.ps1 retrieves. License bundled.
        </TextBlock>
    </StackPanel>
</ContentDialog>
