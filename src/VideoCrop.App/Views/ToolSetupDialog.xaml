<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="VideoCrop.App.Views.ToolSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Set up VideoCrop"
    PrimaryButtonText="Download"
    CloseButtonText="Quit"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Width="460" Spacing="10">
        <TextBlock TextWrapping="Wrap">
            VideoCrop needs ffmpeg and mpv to work. They'll be downloaded into the app's
            <Run FontFamily="Consolas">tools</Run> folder. Roughly 200 MB total.
        </TextBlock>

        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="10"
                Margin="0,4,0,0">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ffmpeg + ffprobe" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="FfmpegStatus" Opacity="0.7" />
                </Grid>
                <ProgressBar x:Name="FfmpegBar" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
        </Border>

        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="6"
                Padding="10">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="mpv" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="MpvStatus" Opacity="0.7" />
                </Grid>
                <ProgressBar x:Name="MpvBar" Minimum="0" Maximum="1" Value="0" />
            </StackPanel>
        </Border>

        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
    </StackPanel>
</ContentDialog>
